struct Tlumaczenie {
    std::wstring tytul;
    std::wstring opcja1;
    std::wstring opcja2;
    std::wstring wybor;
    std::wstring ladowanie;
    std::wstring sukces;
    std::wstring blad;
    std::wstring wyjscie;
};

Tlumaczenie PobierzTlumaczenie() {
    LANGID langId = GetUserDefaultUILanguage();
    Tlumaczenie t;

    if (langId == 0x0415) { // Polski
        t.tytul = L"=== CONTROL PANEL ===";
        t.opcja1 = L"1. Bypass";
        t.opcja2 = L"2. Exit";
        t.wybor = L" Wybierz: ";
        t.ladowanie = L" Bypassing... ";
        t.sukces = L"\n [+] Successfully bypassed grim!";
        t.blad = L" [!] Error!";
        t.wyjscie = L" Closing...";
    }
    else { // Angielski (Domyślny dla reszty świata)
        t.tytul = L"=== CONTROL PANEL ===";
        t.opcja1 = L"1. Bypass";
        t.opcja2 = L"2. Exit";
        t.wybor = L" Select: ";
        t.ladowanie = L" Bypassing... ";
        t.sukces = L"\n [+] Successfully bypassed grim!";
        t.blad = L" [!] Error!";
        t.wyjscie = L" Closing...";
    }
    return t;
}

std::wstring OdszyfrujW(const std::vector<unsigned short>& bajty, unsigned short klucz) {
    std::wstring wynik = L"";
    for (unsigned short b : bajty) wynik += (wchar_t)(b ^ klucz);
    return wynik;
}

void MaskujCzas(const std::wstring& celPath) {
    std::wstring wzorzec = L"C:\\Windows\\System32\\cmd.exe";
    HANDLE hWzorzec = CreateFileW(wzorzec.c_str(), GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
    if (hWzorzec == INVALID_HANDLE_VALUE) return;

    FILETIME stworzony, otwarty, zmodyfikowany;
    if (GetFileTime(hWzorzec, &stworzony, &otwarty, &zmodyfikowany)) {
        HANDLE hCel = CreateFileW(celPath.c_str(), FILE_WRITE_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
        if (hCel != INVALID_HANDLE_VALUE) {
            SetFileTime(hCel, &stworzony, &otwarty, &zmodyfikowany);
            CloseHandle(hCel);
        }
    }
    CloseHandle(hWzorzec);
}

bool WipeFile(const std::wstring& filePath) {
    SetFileAttributesW(filePath.c_str(), FILE_ATTRIBUTE_NORMAL);
    HANDLE hFile = CreateFileW(filePath.c_str(), GENERIC_WRITE, 0, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
    if (hFile == INVALID_HANDLE_VALUE) return false;

    DWORD fileSize = GetFileSize(hFile, NULL);
    if (fileSize != INVALID_FILE_SIZE && fileSize > 0) {
        std::vector<char> bufor(4096, 0);
        DWORD zapisane = 0;
        DWORD pozostalo = fileSize;

        while (pozostalo > 0) {
            DWORD doZapisu = (pozostalo > 4096) ? 4096 : pozostalo;
            WriteFile(hFile, bufor.data(), doZapisu, &zapisane, NULL);
            if (zapisane == 0) break;
            pozostalo -= zapisane;
        }
        FlushFileBuffers(hFile);
    }
    CloseHandle(hFile);

    std::wstring randomPath = filePath.substr(0, filePath.find_last_of(L"\\") + 1) + L"tmp_" + std::to_wstring(GetTickCount64()) + L".tmp";
    if (MoveFileW(filePath.c_str(), randomPath.c_str())) {
        return DeleteFileW(randomPath.c_str());
    }
    return DeleteFileW(filePath.c_str());
}

bool CzyscFolder(const std::wstring& folderPath, const std::wstring& fraza) {
    std::wstring szukajPath = folderPath + L"\\*";
    WIN32_FIND_DATAW ffd;
    HANDLE hFind = FindFirstFileW(szukajPath.c_str(), &ffd);

    if (hFind == INVALID_HANDLE_VALUE) return false;

    bool cokolwiekUsunieto = false;
    do {
        if (!(ffd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) {
            std::wstring fileName = ffd.cFileName;
            if (fileName.find(fraza) != std::wstring::npos) {
                std::wstring pelnaSciezka = folderPath + L"\\" + fileName;
                if (WipeFile(pelnaSciezka)) {
                    cokolwiekUsunieto = true;
                }
            }
        }
    } while (FindNextFileW(hFind, &ffd) != 0);

    FindClose(hFind);
    return cokolwiekUsunieto;
}

bool CzyscBAM(const std::wstring& fraza) {
    HKEY hKey;
    std::wstring bamPath = L"SYSTEM\\CurrentControlSet\\Services\\bam\\State\\UserSettings";
    bool sukces = false;

    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, bamPath.c_str(), 0, KEY_READ | KEY_WRITE, &hKey) == ERROR_SUCCESS) {
        wchar_t subKeyName[256];
        DWORD subKeySize = 256;
        DWORD index = 0;

        while (RegEnumKeyExW(hKey, index, subKeyName, &subKeySize, NULL, NULL, NULL, NULL) == ERROR_SUCCESS) {
            HKEY hSubKey;
            if (RegOpenKeyExW(hKey, subKeyName, 0, KEY_ALL_ACCESS, &hSubKey) == ERROR_SUCCESS) {
                wchar_t valueName[1024];
                DWORD valueNameSize = 1024;
                DWORD vIndex = 0;
                std::vector<std::wstring> doUsuniecia;

                while (RegEnumValueW(hSubKey, vIndex, valueName, &valueNameSize, NULL, NULL, NULL, NULL) == ERROR_SUCCESS) {
                    std::wstring valNameStr = valueName;
                    if (valNameStr.find(fraza) != std::wstring::npos) {
                        doUsuniecia.push_back(valNameStr);
                    }
                    valueNameSize = 1024;
                    vIndex++;
                }

                for (const auto& val : doUsuniecia) {
                    if (RegDeleteValueW(hSubKey, val.c_str()) == ERROR_SUCCESS) {
                        sukces = true;
                    }
                }
                RegCloseKey(hSubKey); // Naprawiono z RegCloseHandle
            }
            subKeySize = 256;
            index++;
        }
        RegCloseKey(hKey); // Naprawiono z RegCloseHandle
    }
    return sukces;
}

void PokazLadowanie(const std::wstring& tekst, int milisekundy) {
    wchar_t animacja[] = { L'/', L'-', L'\\', L'|' };
    int i = 0;
    int czas = 0;
    while (czas < milisekundy) {
        std::wcout << L"\r" << tekst << animacja[i % 4] << std::flush;
        Sleep(100);
        i++;
        czas += 100;
    }
}

int main() {
    SetConsoleOutputCP(CP_UTF8);
    SetConsoleCP(CP_UTF8);

    Tlumaczenie lang = PobierzTlumaczenie();
    int opcja = 0;

    while (true) {
        system("cls");
        std::wcout << lang.tytul << std::endl;
        std::wcout << lang.opcja1 << std::endl;
        std::wcout << lang.opcja2 << std::endl;
        std::wcout << L"----------------------------------------" << std::endl;
        std::wcout << lang.wybor;

        std::cin >> opcja;

        if (std::cin.fail()) {
            std::cin.clear();
            std::cin.ignore(10000, '\n');
            continue;
        }

        if (opcja == 1) {
            system("cls");

            PokazLadowanie(lang.ladowanie, 2000);

            std::vector<unsigned short> cenzuraPrefetch = { 0xED, 0xEE, 0xFC, 0xC3, 0xCD, 0xCE, 0xCE, 0xDF, 0xDD, 0xDB, 0xFC, 0xF4, 0xD6, 0xCD, 0xCC, 0xCD, 0xDC, 0xDB, 0xD2 };
            std::wstring prefetchPath = OdszyfrujW(cenzuraPrefetch, 0x00AA);

            wchar_t tempBuffer[MAX_PATH];
            GetTempPathW(MAX_PATH, tempBuffer);
            std::wstring tempPath = tempBuffer;
            if (!tempPath.empty() && tempPath.back() == L'\\') {
                tempPath.pop_back();
            }

            bool p1 = CzyscFolder(prefetchPath, L"grim");
            bool p2 = CzyscFolder(tempPath, L"grim");
            bool b1 = CzyscBAM(L"grim");

            bool p3 = CzyscFolder(prefetchPath, L"fabric-rendering");
            bool p4 = CzyscFolder(tempPath, L"fabric-rendering");
            bool b2 = CzyscBAM(L"fabric-rendering");

            MaskujCzas(prefetchPath);
            MaskujCzas(tempPath);

            if (b1 || b2 || p1 || p2 || p3 || p4) {
                std::wcout << lang.sukces << std::endl;
            }
            else {
                std::wcout << L"\r" << lang.blad << std::endl;
            }

            Sleep(3000);
        }
        else if (opcja == 2) {
            std::wcout << lang.wyjscie << std::endl;
            Sleep(1000);
            break;
        }
    }
    return 0;
}
